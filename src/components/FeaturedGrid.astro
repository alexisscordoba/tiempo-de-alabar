---
import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Calendar, MapPin, Settings } from "lucide-react";
import { cn } from "../lib/utils";

interface Props {
    featured: {
        song?: string;
        event?: string;
    };
}

const { featured } = Astro.props;

// Fetch Data
const songEntry = featured?.song
    ? await getEntry("musica", featured.song)
    : null;

// Dummy Event Fallback logic
let eventEntry = featured?.event
    ? await getEntry("eventos", featured.event)
    : null;

if (!eventEntry) {
    // 1. Try specific dummy
    eventEntry = await getEntry("eventos", "2026-festival-esperanza");

    // 2. If specific dummy fails, get ANY event
    if (!eventEntry) {
        const allEvents = await getCollection("eventos");
        if (allEvents.length > 0) {
            eventEntry = allEvents[0];
        }
    }
}

const song = songEntry?.data;
const event = eventEntry?.data;

// Formatting
const formatDate = (date: Date) => {
    return (
        new Intl.DateTimeFormat("es-AR", {
            day: "numeric",
            month: "long",
            hour: "2-digit",
            minute: "2-digit",
        }).format(date) + "hs"
    );
};
---

<section
    id="featured-grid"
    class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-20"
>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 items-stretch">
        {/* --- LEFT COLUMN: NEW RELEASE (Square 1:1 Always) --- */}
        <div class="aspect-square relative w-full h-full">
            <a
                href={song ? `/musica/${songEntry?.id}` : "#"}
                class={cn(
                    "group block w-full h-full rounded-[2rem] md:rounded-[2.5rem] overflow-hidden relative shadow-xl md:shadow-2xl transition-transform duration-500 hover:scale-[1.01]",
                    !song && "bg-neutral-800 flex items-center justify-center",
                )}
            >
                {
                    song ? (
                        <>
                            {/* Cover Image */}
                            {song.design?.coverart ? (
                                <Image
                                    src={song.design.coverart}
                                    alt={
                                        song.design.coverart_alt || "Cover Art"
                                    }
                                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 scale-[1.02] group-hover:scale-110"
                                />
                            ) : (
                                <div class="absolute inset-0 bg-neutral-800" />
                            )}

                            {/* Gradient Overlay */}
                            <div class="absolute inset-0 bg-gradient-to-t from-secondary via-secondary/80 to-primary/10 opacity-60 group-hover:opacity-90 transition-opacity duration-500" />

                            {/* Content */}
                            <div class="absolute inset-0 p-6 md:p-8 lg:p-12 flex flex-col justify-between">
                                {/* Badge */}
                                <div class="self-start">
                                    <span class="bg-[#3e8d8b] text-white text-[10px] md:text-xs font-bold px-3 py-1 md:px-4 md:py-1.5 rounded-full uppercase tracking-wider shadow-lg">
                                        Lanzamiento
                                    </span>
                                </div>

                                {/* Title Area */}
                                <div class="transform translate-y-2 md:translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                    <h3 class="text-2xl md:text-3xl lg:text-5xl font-black text-white leading-[0.9] uppercase drop-shadow-lg mb-2">
                                        {song.title}
                                    </h3>
                                    <p class="text-white/80 font-medium text-xs md:text-sm lg:text-base opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                                        Disponible ahora en streaming.
                                    </p>
                                </div>
                            </div>
                        </>
                    ) : (
                        <span class="text-white/20 font-bold text-xl">
                            Próximamente
                        </span>
                    )
                }
            </a>
        </div>

        {/* --- RIGHT COLUMN: STACKED EVENTS & ORGANIZE --- */}
        <div class="flex flex-col gap-4 md:gap-6 h-full min-h-0">
            {/* Top Card: Event (Flexible Height) */}
            <div
                class="flex-1 rounded-[2rem] md:rounded-[2.5rem] bg-[radial-gradient(circle_at_top_left,_var(--tw-gradient-stops))] from-primary/60 via-secondary via-25% to-[#111827] bg-[length:150%_150%] bg-left-top relative overflow-hidden group p-6 md:p-8 lg:p-10 flex flex-col justify-center shadow-xl transition-all duration-1000 ease-in-out hover:shadow-2xl hover:bg-right-bottom border border-white/5 min-h-0"
            >
                {
                    event ? (
                        <a
                            href={`/eventos/${eventEntry?.id}`}
                            class="block h-full flex flex-col justify-center"
                        >
                            <span class="text-white/60 text-[10px] md:text-xs font-bold uppercase tracking-widest mb-2 md:mb-3 block">
                                Próxima Fecha
                            </span>

                            <h3 class="text-xl md:text-2xl lg:text-4xl font-black text-white uppercase leading-none mb-4 md:mb-6 group-hover:text-primary transition-colors duration-300 line-clamp-2">
                                {event.title}
                            </h3>

                            <div class="space-y-2 border-t border-white/10 pt-4">
                                <div class="flex items-center gap-3 text-white/80 group-hover:text-white transition-colors">
                                    <Calendar
                                        size={16}
                                        className="text-primary shrink-0"
                                    />
                                    <span class="uppercase font-bold text-xs md:text-sm tracking-wide truncate">
                                        {formatDate(event.date)}
                                    </span>
                                </div>
                                <div class="flex items-center gap-3 text-white/80 group-hover:text-white transition-colors">
                                    <MapPin
                                        size={16}
                                        className="text-primary shrink-0"
                                    />
                                    <span class="uppercase font-bold text-xs md:text-sm tracking-wide truncate">
                                        {event.location.name}
                                    </span>
                                </div>
                            </div>
                        </a>
                    ) : (
                        <div class="flex flex-col items-center justify-center text-center h-full">
                            <span class="text-white/30 text-lg font-bold">
                                Sin eventos
                            </span>
                        </div>
                    )
                }
            </div>

            {/* Bottom Card: Organize (Auto Height) */}
            <a
                href="/organizar"
                class="h-auto md:basis-1/3 rounded-[2rem] md:rounded-[2.5rem] bg-[#d8c8e1] p-6 md:p-8 lg:p-10 flex items-center justify-between group transition-all duration-300 hover:bg-[#cbb5d6] shadow-lg relative overflow-hidden min-h-0"
            >
                <div>
                    <h3
                        class="text-lg md:text-xl lg:text-3xl font-black text-[#40506d] uppercase leading-[0.9]"
                    >
                        Organizar<br />Evento
                    </h3>
                </div>

                <div
                    class="w-10 h-10 md:w-12 md:h-12 lg:w-14 lg:h-14 bg-white rounded-full flex items-center justify-center shadow-md group-hover:scale-110 transition-transform duration-300 shrink-0"
                >
                    <Settings
                        className="text-[#40506d] group-hover:rotate-90 transition-transform duration-700"
                        size={20}
                    />
                </div>
            </a>
        </div>
    </div>
</section>

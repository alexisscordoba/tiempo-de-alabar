---
import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Calendar, MapPin, Settings } from "lucide-react";
import { cn } from "../lib/utils";

interface Props {
    featured: {
        song?: string;
        event?: string;
    };
}

const { featured } = Astro.props;

// Fetch Data
const songEntry = featured?.song
    ? await getEntry("musica", featured.song)
    : null;

// Dummy Event Fallback logic
let eventEntry = featured?.event
    ? await getEntry("eventos", featured.event)
    : null;

if (!eventEntry) {
    // 1. Try specific dummy
    eventEntry = await getEntry("eventos", "2026-festival-esperanza");

    // 2. If specific dummy fails, get ANY event
    if (!eventEntry) {
        const allEvents = await getCollection("eventos");
        if (allEvents.length > 0) {
            eventEntry = allEvents[0];
        }
    }
}

const song = songEntry?.data;
const event = eventEntry?.data;

// Formatting
const formatDate = (date: Date) => {
    return (
        new Intl.DateTimeFormat("es-AR", {
            day: "numeric",
            month: "long",
            hour: "2-digit",
            minute: "2-digit",
        }).format(date) + "hs"
    );
};
---

<section
    id="featured-grid"
    class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-20"
>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 items-stretch">
        {/* --- LEFT COLUMN: NEW RELEASE (Square 1:1 Always) --- */}
        <div class="aspect-square relative w-full h-full">
            <div
                class={cn(
                    "group block w-full h-full rounded-[2rem] md:rounded-[2.5rem] overflow-hidden transform-gpu relative z-0 shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-all duration-700 hover:shadow-[0_20px_40px_rgba(62,141,139,0.3)] hover:-translate-y-2",
                    !song && "bg-neutral-800 flex items-center justify-center",
                )}
                id="featured-song-card"
                data-song-title={song?.title || ""}
                data-song-slug={songEntry?.id || ""}
                data-song-coverart={song?.design?.coverart && typeof song.design.coverart === 'object' && 'src' in song.design.coverart ? song.design.coverart.src : (typeof song?.design?.coverart === 'string' ? song.design.coverart : "")}
                data-song-streaming={song?.streaming ? JSON.stringify(song.streaming) : "{}"}
            >
                {
                    song ? (
                        <>
                            {/* Cover Image */}
                            {song.design?.coverart ? (
                                <Image
                                    src={song.design.coverart}
                                    alt={
                                        song.design.coverart_alt || "Cover Art"
                                    }
                                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 scale-[1.02] group-hover:scale-110"
                                    id="featured-song-cover-img"
                                />
                            ) : (
                                <div class="absolute inset-0 bg-neutral-800" />
                            )}

                            {/* Gradient Overlay — appears on hover */}
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/40 to-transparent opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-700" />

                            {/* Content Layer */}
                            <div class="absolute inset-0 p-5 md:p-8 lg:p-10 flex flex-col justify-between z-10">
                                {/* Badge — always visible */}
                                <div class="self-start">
                                    <span class="inline-flex items-center bg-white/10 backdrop-blur-md border border-white/20 text-white text-[9px] md:text-[10px] font-bold px-2.5 py-1 md:px-3 md:py-1.5 rounded-full uppercase tracking-widest shadow-xl group-hover:bg-primary/80 group-hover:border-primary transition-all duration-500">
                                        Lanzamiento
                                    </span>
                                </div>

                                {/* Bottom Content — hidden until hover, slides up */}
                                <div class="opacity-0 translate-y-6 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 transition-all duration-700 ease-out flex items-end justify-between gap-4">
                                    {/* Left: Text info */}
                                    <div class="flex flex-col min-w-0">
                                        <span class="text-white/70 text-[10px] md:text-xs font-medium tracking-wide italic mb-1">
                                            Disponible ahora
                                        </span>
                                        <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-black text-white uppercase leading-[0.95] tracking-tight drop-shadow-lg line-clamp-3">
                                            {song.title}
                                        </h3>
                                    </div>

                                    {/* Right: Action buttons */}
                                    <div class="flex items-center gap-2 md:gap-3 shrink-0">
                                        {/* Ver info — navigates to song page */}
                                        <a
                                            href={`/musica/${songEntry?.id}`}
                                            class="inline-flex items-center px-4 py-2 md:px-5 md:py-2.5 rounded-full border border-white/30 text-white text-xs md:text-sm font-bold tracking-wide hover:bg-white hover:text-secondary hover:border-white transition-all duration-300 whitespace-nowrap"
                                        >
                                            Ver info
                                        </a>

                                        {/* Play — opens song streaming modal */}
                                        <button
                                            type="button"
                                            id="featured-song-play-btn"
                                            class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-white text-secondary hover:bg-primary hover:text-white hover:shadow-[0_0_20px_rgba(62,141,139,0.5)] hover:scale-110 transition-all duration-300 flex items-center justify-center shrink-0 shadow-lg cursor-pointer"
                                            aria-label="Reproducir canción"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-0.5 md:w-6 md:h-6"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </>
                    ) : (
                        <span class="text-white/20 font-bold text-xl">
                            Próximamente
                        </span>
                    )
                }
            </div>
        </div>

        {/* --- RIGHT COLUMN: STACKED EVENTS & ORGANIZE --- */}
        <div class="flex flex-col gap-4 md:gap-6 h-full min-h-0">
            {/* Top Card: Event (Flexible Height) */}
            <div
                class="flex-1 rounded-[2rem] md:rounded-[2.5rem] relative z-0 overflow-hidden transform-gpu group p-[2px] transition-all duration-700 ease-out hover:-translate-y-2 min-h-0 shadow-[0_8px_30px_rgb(0,0,0,0.12)] hover:shadow-[0_20px_40px_rgba(62,141,139,0.2)]"
                style="transform: translateZ(0); -webkit-mask-image: -webkit-radial-gradient(white, black);"
            >
                {/* Event Image Base */}
                <img src="/assets/system/event-mockup.png" alt="Evento cristiano" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110 -z-20" />
                
                {/* Strong Overlay for text readability */}
                <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-900/80 to-secondary/40 transition-opacity duration-1000 -z-10"></div>
                
                {/* Vivid Animated Background (Overlay on Hover) */}
                <div class="absolute inset-0 rounded-[2rem] md:rounded-[2.5rem] bg-gradient-to-br from-primary/80 via-secondary/80 to-[#111827]/80 opacity-0 group-hover:opacity-80 transition-opacity duration-700 -z-10 mix-blend-multiply"></div>
                <div class="absolute inset-0 rounded-[2rem] md:rounded-[2.5rem] bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-accent/40 via-transparent to-transparent mix-blend-screen opacity-0 group-hover:opacity-100 transition-opacity duration-1000 -z-10"></div>
                
                {/* Glassmorphism Inner Container */}
                <div class="relative h-full w-full rounded-[1.9rem] md:rounded-[2.4rem] overflow-hidden transform-gpu bg-white/5 backdrop-blur-md border border-white/10 p-6 md:p-8 lg:p-10 flex flex-col justify-center" style="transform: translateZ(0);">
                {
                    event ? (
                        <a
                            href={`/eventos/${eventEntry?.id}`}
                            class="block h-full flex flex-col justify-center relative z-10"
                        >
                            <span class="inline-flex items-center bg-black/20 text-white/90 text-[9px] md:text-[10px] font-bold uppercase tracking-widest mb-4 px-2.5 py-1 md:px-3 md:py-1.5 rounded-full w-fit border border-white/5 group-hover:bg-black/30 transition-colors shadow-sm">
                                Próxima Fecha
                            </span>

                            <h3 class="text-2xl md:text-3xl lg:text-4xl font-black text-white uppercase leading-[1.1] mb-6 group-hover:scale-[1.02] transform origin-left transition-transform duration-500 line-clamp-2">
                                {event.title}
                            </h3>

                            <div class="space-y-3 pt-5 border-t border-white/10 mt-auto">
                                <div class="flex items-center gap-3 text-white/80 group-hover:text-white transition-colors">
                                    <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center shrink-0 border border-white/5 group-hover:scale-110 group-hover:bg-white/20 group-hover:border-white/20 transition-all duration-500">
                                        <Calendar
                                            size={14}
                                            className="text-accent"
                                        />
                                    </div>
                                    <span class="uppercase font-bold text-xs md:text-sm tracking-wide truncate">
                                        {formatDate(event.date)}
                                    </span>
                                </div>
                                <div class="flex items-center gap-3 text-white/80 group-hover:text-white transition-colors">
                                    <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center shrink-0 border border-white/5 group-hover:scale-110 group-hover:bg-white/20 group-hover:border-white/20 transition-all duration-500">
                                        <MapPin
                                            size={14}
                                            className="text-accent"
                                        />
                                    </div>
                                    <span class="uppercase font-bold text-xs md:text-sm tracking-wide truncate">
                                        {event.location.name}
                                    </span>
                                </div>
                            </div>
                        </a>
                    ) : (
                        <div class="flex flex-col items-center justify-center text-center h-full relative z-10">
                            <span class="text-white/30 text-lg font-bold">
                                Sin eventos
                            </span>
                        </div>
                    )
                }
                </div>
            </div>

            {/* Bottom Card: Organize (Auto Height) */}
            <a
                href="/organizar"
                class="h-auto md:basis-1/3 rounded-[2rem] md:rounded-[2.5rem] bg-gradient-to-r from-accent to-[#e2d4e9] p-[2px] flex items-stretch group transition-all duration-700 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(216,200,225,0.4)] relative z-0 overflow-hidden transform-gpu min-h-0"
                style="transform: translateZ(0); -webkit-mask-image: -webkit-radial-gradient(white, black);"
            >
                {/* Inner glass layer */}
                <div class="relative w-full h-full rounded-[1.9rem] md:rounded-[2.4rem] flex items-center justify-between p-6 md:p-8 lg:p-10 bg-white/40 backdrop-blur-md border border-white/50 overflow-hidden transform-gpu" style="transform: translateZ(0);">
                    {/* Decorative glowing orb */}
                    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white blur-3xl opacity-40 group-hover:scale-150 transition-transform duration-1000 -z-10"></div>

                    <div class="relative z-10">
                        <h3
                            class="text-lg md:text-xl lg:text-3xl font-black text-secondary uppercase leading-[0.9] tracking-tight group-hover:text-primary transition-colors duration-500"
                        >
                            Organizar<br />Evento
                        </h3>
                    </div>

                    <div
                        class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 bg-white rounded-full flex items-center justify-center shadow-[0_8px_16px_rgba(0,0,0,0.1)] group-hover:shadow-[0_8px_24px_rgba(62,141,139,0.2)] group-hover:scale-110 transition-all duration-500 shrink-0 relative z-10"
                    >
                        <Settings
                            className="text-primary group-hover:rotate-180 transition-transform duration-1000"
                            size={24}
                        />
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

<script>
    function initFeaturedSongCard() {
        const card = document.getElementById('featured-song-card');
        const playBtn = document.getElementById('featured-song-play-btn');
        if (!card || !playBtn) return;

        // Prevent duplicate listeners across View Transitions
        if (playBtn.dataset.bound === 'true') return;
        playBtn.dataset.bound = 'true';

        playBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const title = card.dataset.songTitle || '';
            const streaming = JSON.parse(card.dataset.songStreaming || '{}');

            // Get the resolved image src from the rendered <img> tag
            const coverImg = document.getElementById('featured-song-cover-img') as HTMLImageElement | null;
            const coverArt = coverImg?.currentSrc || coverImg?.src || card.dataset.songCoverart || '';

            window.dispatchEvent(
                new CustomEvent('open-song-modal', {
                    detail: { title, coverArt, streaming },
                })
            );
        });
    }

    // Run on initial load
    initFeaturedSongCard();

    // Re-run after Astro View Transitions
    document.addEventListener('astro:after-swap', initFeaturedSongCard);
</script>

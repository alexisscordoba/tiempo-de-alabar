---
interface Props {
    text: string;
    author?: string;
    backgroundImage?: string;
}

const { text, author, backgroundImage } = Astro.props;
---

<section
    class="relative py-20 px-4 overflow-hidden flex items-center justify-center bg-gradient-to-br from-secondary to-[#2a364a]"
>
    {/* Background Ambient Light */}
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-gradient-radial from-white/10 to-transparent opacity-40 blur-3xl"
        >
        </div>
    </div>

    <div class="relative z-10 w-full max-w-5xl">
        {/* Glass Card Container */}
        <div
            class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 backdrop-blur-md shadow-2xl group transition-transform duration-700 hover:scale-[1.01]"
        >
            {/* Inner Glow Effect */}
            <div
                class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-black/20 pointer-events-none"
            >
            </div>

            <div
                class="relative flex flex-col md:flex-row items-center p-8 md:p-12 gap-8 md:gap-12"
            >
                {/* Quote Icon & Decorative Line */}
                <div class="flex-shrink-0 flex flex-col items-center gap-4">
                    <span
                        class="text-6xl text-accent/40 font-serif leading-none"
                        >“</span
                    >
                    <div
                        class="hidden md:block w-[1px] h-24 bg-gradient-to-b from-accent/40 to-transparent"
                    >
                    </div>
                </div>

                {/* Main Content */}
                <div class="flex-1 text-center md:text-left">
                    <h2
                        class="text-2xl md:text-4xl lg:text-5xl font-serif italic text-white leading-tight tracking-tight drop-shadow-lg mb-6"
                    >
                        {text}
                    </h2>

                    {
                        author && (
                            <div class="flex items-center justify-center md:justify-start gap-4">
                                <div class="w-8 h-[1px] bg-accent/50" />
                                <p class="text-sm md:text-base font-sans font-medium text-white/70 uppercase tracking-[0.2em]">
                                    {author}
                                </p>
                            </div>
                        )
                    }
                </div>

                {
                    /* Optional Decorative Right Element (e.g. subtle brand mark or just space) */
                }
                <div
                    class="hidden lg:block absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-white/5 to-transparent pointer-events-none"
                >
                </div>
            </div>
        </div>
    </div>
</section>
